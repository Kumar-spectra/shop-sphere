# ========================================================
# SHOPSPHERE CONFIGURATION
# Default: Runs in ₹0 Learning Mode without paid keys!
# ========================================================

# Application Mode
NEXT_PUBLIC_LEARNING_MODE=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Database & Auth - Free Tier / Local / Mock fallback)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cashfree Payments (India) - Sandbox / Production
# Leave empty to use the built-in interactive payment simulator
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST
CASHFREE_WEBHOOK_SECRET=

# Shiprocket Logistics (India) - Real Courier or Simulator
# Leave empty to use the built-in interactive logistics simulator
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_TOKEN=

# Marketplace Affiliate Integrations (Optional)
# Leave empty to use simulated partner search results
AMAZON_ASSOCIATE_TAG=shopsphere-21
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
EBAY_APP_ID=
EBAY_CERT_ID=

# Stripe Configuration (Legacy / Optional)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
